<?xml version="1.0" encoding="utf-8"?>
<!--
  بروفايل النشر «Installer»: كل Publish بيطلع مثبّت جديد في فولدر Releases جنب المشروع:

    E:\CLEANER\Releases\PCCare-Setup-test-20261117-1130.exe   ← من Visual Studio (للتجربة)
    PCCare-Setup-1.0.5.exe                                    ← من GitHub Actions (الرسمي)

  الملف ده هو كل اللي تنقله لأي جهاز (مش محتاج .NET).
  الملف ده متعمد يكون بسيط — كل المنطق في PCCare.csproj.

  من سطر الأوامر:   dotnet publish PCCare\PCCare.csproj -p:PublishProfile=Installer
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishProtocol>FileSystem</PublishProtocol>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\Releases\_staging\</PublishDir>
    <PcRelease>true</PcRelease>
  </PropertyGroup>
</Project>
