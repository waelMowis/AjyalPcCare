<?xml version="1.0" encoding="utf-8"?>
<!--
  بروفايل النشر «GitHub» = نفس publish.cmd (دبل كليك) بالظبط:

    1. اكتب الجديد في ReleaseNotes.md واحفظ
    2. Publish ← GitHub
       ← Commit + Push
       ← GitHub Actions يبني ويفحص (smoke test) وينشر الإصدار الرسمي (والقديم على GitHub يتمسح)
       ← المثبّت الجديد ينزل في E:\CLEANER\Releases ويتمسح أي مثبّت قديم (ملف واحد بس)
    3. الأجهزة تشوف «فيه تحديث» في التحقق الجاي

  التقدّم بيظهر في نافذة Output (ممكن ياخد من 4 لـ 8 دقايق لحد ما GitHub يخلص).
  ملحوظة: الـ Publish ده مابيبنيش مثبّت محلي — بيبني البرنامج بس عشان يتأكد إنه بيتبني قبل الرفع.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishProtocol>FileSystem</PublishProtocol>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\obj\github-publish\</PublishDir>
    <PcGitHubPublish>true</PcGitHubPublish>
  </PropertyGroup>
</Project>
